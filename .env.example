# AI Website Builder - Environment Variables

# JWT / Auth
SECRET_KEY=change_me_to_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Database (SQLite default for local dev)
DATABASE_URL=sqlite:///.tmp/builder_auth.db

# First admin (created once on startup if no admin exists)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change_me_admin_password
FIRST_ADMIN_FULL_NAME=Platform Admin

# SMTP (optional — OTP is logged to console when not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
