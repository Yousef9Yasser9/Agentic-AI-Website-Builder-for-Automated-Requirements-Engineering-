import jwt as _jwt
import os as _os

_JWT_SECRET = _os.getenv("JWT_SECRET", "dev-secret-change-me")
_JWT_ALGO   = "HS256"

def _get_page_role(request: Request) -> str:
    """Extract user role from Bearer token in Authorization header."""
    try:
        auth = request.headers.get("Authorization", "")
        token = auth.replace("Bearer ", "").strip()
        if not token:
            # Try cookie fallback
            token = request.cookies.get("access_token", "")
        if not token:
            return ""
        payload = _jwt.decode(token, _JWT_SECRET, algorithms=[_JWT_ALGO])
        return (payload.get("role") or "").lower()
    except Exception:
        return ""

