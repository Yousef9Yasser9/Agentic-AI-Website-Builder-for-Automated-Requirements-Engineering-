# ── Frontend HTML files dir ────────────────────────────────────────────────
_FRONTEND_DIR = Path(__file__).resolve().parent.parent / "frontend_templates"


def _html(filename: str, entity: str = None) -> Response:
    """Serve a pre-rendered HTML file from frontend_templates/ with cache-busting and entity injection."""
    path = _FRONTEND_DIR / filename
    if not path.exists():
        return JSONResponse({"error": f"{filename} not found in frontend_templates/"}, status_code=404)
    
    content = path.read_text(encoding="utf-8")
    
    # Injection logic for custom entities (Gallery, Cart, Checkout, etc.)
    if entity:
        injected_js = f'<script>window.ENTITY_OVERRIDE = "{entity.lower()}s"; window.ENTITY_SINGULAR_OVERRIDE = "{entity.lower()}";</script>'
        if "</head>" in content:
            content = content.replace("</head>", f"{injected_js}\n</head>")
        else:
            content = injected_js + content

    return Response(
        content=content,
        media_type="text/html",
        headers={
            "Cache-Control": "no-cache, no-store, must-revalidate",
            "Pragma": "no-cache",
            "Expires": "0",
            "X-Project-ID": "{{ project_id }}"
        }
    )


# ── App lifespan ───────────────────────────────────────────────────────────
