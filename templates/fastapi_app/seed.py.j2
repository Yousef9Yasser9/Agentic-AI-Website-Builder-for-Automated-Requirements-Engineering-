"""
Deterministic database seeder generated by AI Website Builder.
Creates small, realistic demo data and keeps relationships consistent.
"""
import os
import re
import sys
from datetime import date, datetime, timedelta
from pathlib import Path
from uuid import uuid4

_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(_ROOT))
os.environ.setdefault("DATABASE_URL", "sqlite:///./app.db")

_env_file = _ROOT / ".env"
if _env_file.exists():
    for _line in _env_file.read_text(encoding="utf-8").splitlines():
        _line = _line.strip()
        if _line and not _line.startswith("#") and "=" in _line:
            _k, _v = _line.split("=", 1)
            os.environ.setdefault(_k.strip(), _v.strip().strip('"').strip("'"))

from sqlalchemy import func, select

from app import models
from app.auth import hash_password
from app.db import Base, SessionLocal, engine


def _column_names(model_class):
    return {c.key for c in model_class.__table__.columns}


def _filter_kwargs(model_class, kwargs):
    cols = _column_names(model_class)
    return {k: v for k, v in kwargs.items() if k in cols}


def _count_rows(db, model_class) -> int:
    return db.execute(select(func.count()).select_from(model_class)).scalar_one() or 0


def _entity_key(value) -> str:
    return re.sub(r"[^a-z0-9]+", "", str(value or "").lower())


_SEEDED_RECORDS = {}


def _remember(entity_name, obj):
    _SEEDED_RECORDS.setdefault(_entity_key(entity_name), []).append(obj)


def _pick_seeded_id(field_name: str, index: int = 0):
    base = field_name.removesuffix("_id")
    wanted = {
        _entity_key(base),
        _entity_key(base + "s"),
        _entity_key(base.replace("_", "")),
    }
    if base.endswith("_type"):
        wanted.add(_entity_key(base.replace("_type", "type")))
    for key, rows in _SEEDED_RECORDS.items():
        if rows and (key in wanted or any(key.endswith(item) or item.endswith(key) for item in wanted if item)):
            return rows[index % len(rows)].id
    return None


def _public_user(role_users: dict):
    for role, user in role_users.items():
        if role != "admin":
            return user
    return role_users.get("admin")


def _related_uuid(field_name: str, index: int, role_users: dict, admin):
    base = field_name.removesuffix("_id").lower()
    if base in role_users:
        return role_users[base].id
    linked = _pick_seeded_id(field_name, index)
    if linked is not None:
        return linked
    if field_name in {"user_id", "owner_id", "customer_id", "created_by", "uploader_id"}:
        user = _public_user(role_users) or admin
        if user is not None:
            return user.id
    return uuid4()


def _sample_string(entity_name: str, field_name: str, index: int) -> str:
    entity = _entity_key(entity_name)
    field = field_name.lower()
    n = index + 1
    if "email" in field:
        return f"demo{n}@example.com"
    if "phone" in field:
        return f"+1-555-010{n}"
    if "address" in field:
        return f"{100 + n} Main Street"
    if "registration" in field or field in {"plate", "license_plate"}:
        return f"CAR-{2020 + n}-{100 + n}"
    if field == "make":
        return ["Toyota", "Honda", "Ford", "Nissan", "Chevrolet"][index % 5]
    if field == "model":
        return ["Camry", "Civic", "Focus", "Altima", "Malibu"][index % 5]
    if "status" in field:
        return ["Scheduled", "In Progress", "Waiting Parts", "Completed", "Cancelled"][index % 5]
    if "description" in field:
        return f"Practical {entity_name.lower()} details for everyday use"
    if field in {"content", "note", "message", "notes"}:
        return [
            "Checked brakes and fluids",
            "Customer requested morning slot",
            "Parts ordered",
            "Inspection completed",
            "Follow-up recommended",
        ][index % 5]
    if "service" in entity or "type" in entity:
        if field in {"name", "title"}:
            return ["Oil Change", "Brake Inspection", "Battery Check", "Tire Rotation", "Engine Diagnostic"][index % 5]
    if field in {"name", "title"}:
        return f"{entity_name} {n}"
    return f"{entity_name} {field_name.replace('_', ' ')} {n}"


def _sample_int(entity_name: str, field_name: str, index: int) -> int:
    field = field_name.lower()
    if "year" in field:
        return 2018 + (index % 7)
    if "capacity" in field:
        return 1 + (index % 4)
    if any(word in field for word in ("quantity", "stock", "count")):
        return 5 + index
    return index + 1


def _sample_decimal(entity_name: str, field_name: str, index: int) -> float:
    field = field_name.lower()
    if "total" in field or "amount" in field or "price" in field or "cost" in field:
        return round(75.0 + (index * 24.5), 2)
    return round(10.0 + index, 2)


DEMO_ACCOUNTS = {{ demo_accounts | tojson }}
PUBLIC_ROLE = {{ public_role | tojson }}
_ADMIN_ACCOUNT = DEMO_ACCOUNTS.get("Admin") or DEMO_ACCOUNTS.get("admin") or {"email": "admin@example.com", "password": "Admin1234!"}
ADMIN_EMAIL = _ADMIN_ACCOUNT["email"]
ADMIN_PASSWORD = _ADMIN_ACCOUNT["password"]


def seed():
    db = SessionLocal()
    try:
        Base.metadata.create_all(bind=engine)

        if hasattr(models, "User"):
            role_users = {}
            roles_to_seed = {{ contract.roles | tojson }}
            for role in roles_to_seed:
                account = DEMO_ACCOUNTS.get(role) or DEMO_ACCOUNTS.get(str(role).title()) or {}
                email = account.get("email") or f"{str(role).lower()}@example.com"
                pwd = account.get("password") or "User1234!"
                user = db.execute(select(models.User).where(models.User.email == email)).scalar_one_or_none()
                if not user:
                    user_kwargs = {
                        "id": uuid4(),
                        "email": email,
                        "password_hash": hash_password(pwd),
                        "role": role.lower(),
                        "full_name": f"Demo {role}",
                        "phone": f"+1-555-01{len(role_users):02d}",
                        "address": f"{100 + len(role_users)} Demo Street",
                        "name": f"Demo {role}",
                        "is_active": True,
                        "is_superuser": (role.lower() == "admin"),
                    }
                    user = models.User(**_filter_kwargs(models.User, user_kwargs))
                    db.add(user)
                    print(f"Created {role} user: {email}")
                role_users[str(role).lower()] = user
            db.commit()
            admin = db.execute(select(models.User).where(models.User.email == ADMIN_EMAIL)).scalar_one_or_none()
            if not admin:
                admin = db.execute(select(models.User).limit(1)).scalar_one_or_none()
            public_user = _public_user(role_users) or admin
        else:
            print("No User model found; skipping demo account creation")
            admin = None
            public_user = None
            role_users = {}
            roles_to_seed = []

        {% for entity in data_model.entities %}
        try:
            model_class = getattr(models, "{{ entity.class_name }}", None)
            if model_class is not None:
                existing_rows = db.execute(select(model_class).limit(20)).scalars().all()
                for existing in existing_rows:
                    _remember("{{ entity.name }}", existing)
                if not existing_rows:
                    for i in range(5):
                        new_kwargs = {"id": uuid4()}
                        {% for field in entity.fields %}
                        {% if not field.pk and not field.name.endswith('_at') %}
                        {% set field_type = (field.python_type or 'str') | lower %}
                        {% if field_type == 'str' %}
                        _role_user = role_users.get("{{ field.name }}".lower())
                        if _role_user is not None:
                            new_kwargs["{{ field.name }}"] = _role_user.email
                        else:
                            new_kwargs["{{ field.name }}"] = _sample_string("{{ entity.name }}", "{{ field.name }}", i)
                        {% elif field_type == 'int' %}
                        new_kwargs["{{ field.name }}"] = _sample_int("{{ entity.name }}", "{{ field.name }}", i)
                        {% elif field_type == 'float' %}
                        new_kwargs["{{ field.name }}"] = _sample_decimal("{{ entity.name }}", "{{ field.name }}", i)
                        {% elif field_type == 'bool' %}
                        new_kwargs["{{ field.name }}"] = (i % 2 == 0)
                        {% elif field_type == 'date' %}
                        new_kwargs["{{ field.name }}"] = date.today() + timedelta(days=i + 1)
                        {% elif field_type == 'datetime' %}
                        new_kwargs["{{ field.name }}"] = datetime.now() + timedelta(days=i + 1, hours=9 + i)
                        {% elif field_type == 'uuid' %}
                        new_kwargs["{{ field.name }}"] = _related_uuid("{{ field.name }}", i, role_users, admin)
                        {% endif %}
                        {% endif %}
                        {% endfor %}
                        final_kwargs = _filter_kwargs(model_class, new_kwargs)
                        new_obj = model_class(**final_kwargs)
                        db.add(new_obj)
                        _remember("{{ entity.name }}", new_obj)
                    db.commit()
                    print("Successfully seeded {{ entity.name }}s")
        except Exception as e:
            db.rollback()
            print(f"Error seeding {{ entity.name }}: {e}")
        {% endfor %}

        print("Seeding complete!")
        print(f"Admin login: {ADMIN_EMAIL} / {ADMIN_PASSWORD}")
        for role in roles_to_seed:
            if str(role).lower() == "admin":
                continue
            account = DEMO_ACCOUNTS.get(role) or DEMO_ACCOUNTS.get(str(role).title()) or {}
            email = account.get("email") or f"{str(role).lower()}@example.com"
            pwd = account.get("password") or "User1234!"
            print(f"{role} login: {email} / {pwd}")
    finally:
        db.close()


def main():
    seed()


if __name__ == "__main__":
    main()
