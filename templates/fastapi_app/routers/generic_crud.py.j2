    role = _role_of(user)
    return role == "admin" or role in allowed


def _scope_query(query, model_class, current_user, scope_fields):
    if _role_of(current_user) == "admin":
        return query
    for scope_field in scope_fields or []:
        if hasattr(model_class, scope_field):
            query = query.filter(getattr(model_class, scope_field) == current_user.id)
    return query


def _stamp_owner(data, model_class, current_user, scope_fields):
